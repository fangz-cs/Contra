include LICENSE README.md .gitignore .env.example
include .claude-plugin/marketplace.json
recursive-include code *.py *.md
recursive-include plugin *.py *.md *.json LICENSE
recursive-include configs *.yaml
global-exclude *.py[cod] *.jsonl *.csv *.tsv *.parquet *.zip *.pdf *.tex *.bib
prune .git
prune .venv
prune .pytest_cache
