{
  "env": {
    "CONTRA_SYNC_VERIFY": "1"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/record_baseline.py\"",
            "timeout": 60,
            "statusMessage": "CONTRA: recording this turn's baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/verify_disclosures.py\"",
            "timeout": 900,
            "statusMessage": "CONTRA: finding and verifying decisions"
          }
        ]
      }
    ]
  }
}
